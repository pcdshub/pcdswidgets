/*
 * Look and feel of the expanded state mover (motor_state_mover_expanded.py).
 *
 * The widgets only carry properties and this file decides how they look:
 *   role     what the widget is (header, cell, bar, ...)
 *   variant  which kind of bar
 *   state    the bar's current value (set from the PV)
 *   error    the error message's error flag
 *   bold     "true" for the bold variant of a cell
 *
 * Palette: slate rgb(52, 73, 94), mute rgb(125, 125, 125), cell text
 * rgb(51, 51, 51), cell fill rgb(244, 244, 244), cell border rgb(201, 201, 201),
 * blue rgb(20, 100, 239), blue (hover) rgb(15, 80, 200), grey rgb(150, 150, 150),
 * red rgb(220, 40, 40).
 */

/* tabs */
QTabWidget#expertTabs::pane {
    border: 1px solid rgb(207, 214, 220);
    border-radius: 6px;
    top: -1px;
    background: rgb(251, 252, 253);
}

QTabWidget#expertTabs QTabBar::tab {
    background: rgb(233, 237, 240);
    color: rgb(125, 125, 125);
    padding: 6px 18px;
    border: 1px solid rgb(207, 214, 220);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabWidget#expertTabs QTabBar::tab:selected {
    background: rgb(251, 252, 253);
    color: rgb(52, 73, 94);
}

/* scroll areas draw nothing of their own */
QScrollArea[role="transparent"] {
    background: transparent;
    border: none;
}

QScrollArea[role="transparent"] > QWidget > QWidget {
    background: transparent;
}

/* titled frame */
QGroupBox[role="group"] {
    font: bold 10pt "DejaVu Sans";
    color: rgb(52, 73, 94);
    border: 1px solid rgb(207, 214, 220);
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background: transparent;
}

QGroupBox[role="group"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
}

/* labels next to the values */
QLabel[role="header"] {
    font: bold 10pt "DejaVu Sans";
    color: rgb(52, 73, 94);
    background: transparent;
}

QLabel[role="header-sub"] {
    font: bold 9pt "DejaVu Sans";
    color: rgb(125, 125, 125);
    background: transparent;
}

QLabel[role="row-label"] {
    font: bold 10pt "DejaVu Sans";
    color: rgb(52, 73, 94);
    background: transparent;
}

/* read-only values */
QLabel[role="cell"] {
    font: 10pt "DejaVu Sans";
    color: rgb(51, 51, 51);
    background: rgb(244, 244, 244);
    border: 1px solid rgb(201, 201, 201);
    border-radius: 4px;
    padding: 0 8px;
}

QLabel[role="cell"][bold="true"] {
    font-weight: bold;
}

QLabel[role="signal"] {
    font: 10pt "DejaVu Sans";
    color: rgb(51, 51, 51);
    background: rgb(244, 244, 244);
    border: 1px solid rgb(201, 201, 201);
    border-radius: 4px;
    padding: 2px 10px;
}

/* error message: red only while the error flag is set */
QLabel[role="message"] {
    font: 10pt "DejaVu Sans";
    color: rgb(51, 51, 51);
    background: white;
    border: 1px solid rgb(201, 201, 201);
    border-radius: 4px;
    padding: 2px 10px;
}

QLabel[role="message"][error="true"] {
    color: rgb(220, 40, 40);
    background: rgb(253, 236, 236);
    border: 1px solid rgb(220, 40, 40);
}

/* value bars */
QLabel[role="bar"] {
    font: bold 10pt "DejaVu Sans";
    color: white;
    background: rgb(150, 150, 150);
    border: 1px solid rgba(0, 0, 0, 40);
    border-radius: 8px;
}

/* led: blue when set, grey when clear */
QLabel[role="bar"][variant="led"][state="on"] {
    background: rgb(20, 100, 239);
}

/* always-on: blue whatever the value */
QLabel[role="bar"][variant="always-on"] {
    background: rgb(20, 100, 239);
}

/* error: red when set, blue when clear */
QLabel[role="bar"][variant="error"][state="off"] {
    background: rgb(20, 100, 239);
}

QLabel[role="bar"][variant="error"][state="on"] {
    background: rgb(220, 40, 40);
}

/* transit status: UNKNOWN amber, AT_STATE green, IN_TRANSIT blue, axis error red */
QLabel[role="bar"][variant="status"][state="unknown"] {
    background: rgb(224, 138, 20);
}

QLabel[role="bar"][variant="status"][state="at-state"] {
    background: rgb(46, 160, 67);
}

QLabel[role="bar"][variant="status"][state="in-transit"] {
    background: rgb(20, 100, 239);
}

QLabel[role="bar"][variant="status"][state="error"] {
    background: rgb(220, 40, 40);
}

/* target-state selector, same look as the plain mover's (motor_state_mover.ui) */
QComboBox[role="setpoint-combo"] {
    font: 10pt "DejaVu Sans";
    color: rgb(120, 120, 120);
    background-color: rgb(255, 255, 255);
    border: 2px solid rgb(42, 91, 215);
    border-radius: 3px;
    padding-left: 10px;
}

QComboBox[role="setpoint-combo"]::drop-down {
    width: 26px;
    border-left: 1px solid rgb(208, 208, 208);
}

QComboBox[role="setpoint-combo"]::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid rgb(154, 154, 154);
    margin-right: 8px;
}

/* buttons: grey at rest, blue on hover, darker blue while pressed */
QPushButton[role="icon-button"] {
    background: rgb(233, 237, 240);
    border: 1px solid rgb(201, 201, 201);
    border-radius: 4px;
    padding: 0;
}

QPushButton[role="command-button"] {
    background: rgb(233, 237, 240);
    border: 1px solid rgb(201, 201, 201);
    border-radius: 4px;
    padding: 2px 10px;
}

QPushButton[role="icon-button"]:hover,
QPushButton[role="command-button"]:hover {
    background: rgb(20, 100, 239);
    border: 1px solid rgb(15, 80, 200);
}

QPushButton[role="icon-button"]:pressed,
QPushButton[role="command-button"]:pressed {
    background: rgb(15, 80, 200);
}
