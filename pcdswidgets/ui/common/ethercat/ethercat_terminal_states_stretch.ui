<?xml version="1.0" encoding="UTF-8"?>
<!--
  pcdswidgets EthercatTerminalStatesStretch (ECS Common Ethercat), size class "stretch":
  every EtherCAT terminal of one PLC as a tree with per-group status roll-up, a filter
  toolbar and the selected terminal (EthercatTerminalStateDoubleRow) below.
  Designed at 850 x 1000 (docked system-summary size), minimum 850 x 560.
  Configured by designer properties (plc, prefix, discoveryFile, mock, ...) handled in
  pcdswidgets/common/ethercat/ethercat_terminal_states_stretch.py; no macros in this file.
  No inline styleSheet: the look comes from the application theme; status colours come
  from ethercat_status.qss (ecatStatus rules).
-->
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>850</width><height>1000</height></rect>
